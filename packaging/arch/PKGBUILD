# Maintainer: Andreas Røsdal <andreas dot rosdal at gmail dot com>

pkgname=southstar-browser
pkgver=1.0.1
pkgrel=1
pkgdesc='Small, hand-written web browser in Rust, with a GTK 4 interface'
arch=(x86_64 aarch64)
url='https://github.com/nordstjernen-web/southstar-browser'
license=('LicenseRef-NSL-1.0 OR GPL-3.0-or-later')
depends=(
  brotli
  cairo
  enchant
  ffmpeg
  fontconfig
  freetype2
  fribidi
  gdk-pixbuf2
  glib2
  glibc
  gtk4
  harfbuzz
  hicolor-icon-theme
  libavif
  libepoxy
  libgcc
  libpsl
  libseccomp
  libvorbis
  libwebp
  openssl
  opusfile
  poppler-glib
  sdl2
  sqlite
  uchardet
  zlib
  zstd
)
makedepends=(cargo)
optdepends=(
  'hunspell: spell checking'
  'hunspell-en_us: English dictionary for spell checking'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/nordstjernen-web/southstar-browser/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('452d43e0cdc10ead87194389d23023f407032ee6b16f237de96ac295893980fc')

_srcdir=southstar-browser-$pkgver
_xtask_args=(
  --webgpu disabled
  --avif enabled
  --audio enabled
  --build-date "$(date -u -d "@${SOURCE_DATE_EPOCH:-$(date +%s)}" +%F)"
)

prepare() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_NET_OFFLINE=true
  # The engine is linked with fat LTO; with full debug info the link needs
  # more than 8 GB of memory, so the debug package keeps line tables.
  RUSTFLAGS=${RUSTFLAGS//-C debuginfo=2/-C debuginfo=line-tables-only}
  export RUSTFLAGS
  # rustc links the C objects cargo builds (ring's) without GCC's LTO
  # plugin, so they also carry machine code.
  export CFLAGS+=" -ffat-lto-objects"
  # wgpu-native is not in the Arch repositories, so WebGPU is left out. AVIF
  # and the audio helper are required explicitly so a missing dependency fails
  # the build instead of dropping a feature.
  cd "$_srcdir"
  cargo xtask build "${_xtask_args[@]}"
}

package() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_NET_OFFLINE=true
  RUSTFLAGS=${RUSTFLAGS//-C debuginfo=2/-C debuginfo=line-tables-only}
  export RUSTFLAGS
  export CFLAGS+=" -ffat-lto-objects"
  cargo xtask install "${_xtask_args[@]}" --prefix /usr --destdir "$pkgdir"

  # libsouthstar.so and its header are the embedding API; the browser links
  # the engine statically, and the library has no SONAME version.
  rm "$pkgdir/usr/lib/libsouthstar.so"
  rm -r "$pkgdir/usr/include"
  find "$pkgdir/usr/lib" -type d -empty -delete

  install -d "$pkgdir/usr/share/licenses/$pkgname"
  ln -s /usr/share/southstar/License.md "$pkgdir/usr/share/licenses/$pkgname/"
  ln -s /usr/share/southstar/COPYING "$pkgdir/usr/share/licenses/$pkgname/"
}
